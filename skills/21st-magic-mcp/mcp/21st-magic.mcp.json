{
  "mcpServers": {
    "21st-magic": {
      "command": "npx",
      "args": ["-y", "@21st-dev/magic@latest"],
      "lifecycle": "lazy",
      "idleTimeout": 10,
      "cwd": "~/.cache/21st-magic-mcp",
      "env": {
        "TWENTY_FIRST_API_KEY": "${TWENTY_FIRST_API_KEY}",
        "API_KEY": "${API_KEY}"
      },
      "directTools": [
        "21st_magic_component_inspiration",
        "logo_search"
      ]
    }
  }
}
