{
  "name": "pi-agent-setup",
  "private": true,
  "version": "0.1.0",
  "description": "Public non-secret bootstrap for a Pi/Codex AAD agent stack.",
  "keywords": [
    "pi-package",
    "agentic-workflow",
    "codex",
    "aad"
  ],
  "pi": {
    "extensions": [
      "./extensions/ready-notify.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "pi-subagents": "^0.34.0"
  },
  "scripts": {
    "secrets:check": "bash scripts/secrets-check.sh",
    "test:runtime-resolution": "bash scripts/test-runtime-resolution.sh",
    "verify:remote": "bash scripts/pi-setup remote verify",
    "install:remote": "bash scripts/pi-setup remote install",
    "setup:local": "bash scripts/pi-setup local install",
    "setup:remote:install": "bash scripts/pi-setup remote install",
    "setup:remote:verify": "bash scripts/pi-setup remote verify",
    "test:pi-setup": "bash scripts/test-pi-setup.sh",
    "test:setup-architecture": "bash scripts/test-setup-architecture.sh",
    "test:setup-deployment": "bash scripts/test-setup-deployment.sh",
    "test:config-components": "python3 scripts/test-config-components.py ."
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  }
}
