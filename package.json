{
  "name": "pi-agent-setup",
  "private": true,
  "version": "0.1.0",
  "description": "Public non-secret bootstrap for a Pi/Codex AAD agent stack.",
  "keywords": [
    "pi-package",
    "agentic-workflow",
    "codex",
    "aad"
  ],
  "pi": {
    "extensions": [
      "./extensions/ready-notify.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "pi-subagents": "^0.34.0"
  },
  "scripts": {
    "secrets:check": "bash scripts/secrets-check.sh",
    "test:runtime-resolution": "bash scripts/test-runtime-resolution.sh",
    "verify:remote": "bash scripts/verify-remote.sh",
    "install:remote": "bash scripts/install-remote.sh"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  }
}
