{
  "name": "pi-agent-setup",
  "private": true,
  "version": "0.1.0",
  "description": "Public, non-secret local setup for a personal Pi/Codex/OpenCode AAD workflow.",
  "type": "module",
  "main": "./.opencode/plugins/pi-agent-setup.js",
  "keywords": [
    "pi-package",
    "agentic-workflow",
    "codex",
    "opencode",
    "aad"
  ],
  "pi": {
    "extensions": [
      "./extensions/ready-notify.ts",
      "./extensions/main-thread-wait-guard.ts"
    ],
    "skills": [
      "./skills/general",
      "./skills/common",
      "./skills/aad"
    ]
  },
  "dependencies": {
    "pi-subagents": "^0.34.0"
  },
  "scripts": {
    "setup:local": "bash scripts/update-local.sh",
    "test": "npm run test:config && npm run test:local-assets && npm run test:runtime-resolution && npm run test:opencode && npm run test:main-thread-wait-guard",
    "test:config": "python3 scripts/test-config-components.py .",
    "test:local-assets": "bash scripts/test-local-assets.sh",
    "test:runtime-resolution": "bash scripts/test-runtime-resolution.sh",
    "test:opencode": "node scripts/test-opencode-adapter.mjs",
    "test:main-thread-wait-guard": "node scripts/test-main-thread-wait-guard.mjs",
    "secrets:check": "bash scripts/secrets-check.sh"
  },
  "engines": {
    "opencode": ">=1.18.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  }
}
